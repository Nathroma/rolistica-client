{
  "name": "character-sheet-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "lint:check": "eslint .",
